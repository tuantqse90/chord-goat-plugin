{
  "name": "chord-goat-plugin",
  "version": "0.1.0",
  "description": "Chord swap tools for GOAT: token search, best-route quotes, unsigned swap transactions and swaps through the Chord router on eight EVM chains.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --no-cache",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier -c \"**/*.{ts,json,md}\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "goat",
    "goat-sdk",
    "chord",
    "swap",
    "dex-aggregator",
    "ai",
    "agent",
    "evm"
  ],
  "homepage": "https://getchord.xyz/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuantqse90/chord-goat-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/tuantqse90/chord-goat-plugin/issues"
  },
  "peerDependencies": {
    "@goat-sdk/core": "^0.5.0",
    "@goat-sdk/wallet-evm": "^0.3.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@goat-sdk/core": "^0.5.0",
    "@goat-sdk/wallet-evm": "^0.3.0",
    "@goat-sdk/wallet-viem": "^0.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "viem": "^2.23.4",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  }
}
